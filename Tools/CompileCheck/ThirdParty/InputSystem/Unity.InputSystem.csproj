<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds com.unity.inputsystem (1.14.2) runtime from package source (compile-check only). -->
  <PropertyGroup>
    <UnityProject>true</UnityProject>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputPath>$(CompileCheckOut)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>Unity.InputSystem</AssemblyName>
    <DefineConstants>$(UnityDefines);UNITY_INPUT_SYSTEM_ENABLE_VR;UNITY_INPUT_SYSTEM_ENABLE_XR;UNITY_INPUT_SYSTEM_ENABLE_PHYSICS;UNITY_INPUT_SYSTEM_ENABLE_PHYSICS2D;UNITY_INPUT_SYSTEM_ENABLE_UI;HAS_SET_LOCAL_POSITION_AND_ROTATION;UNITY_INPUT_SYSTEM_PROJECT_WIDE_ACTIONS;UNITY_INPUT_SYSTEM_PLATFORM_SCROLL_DELTA;UNITY_INPUT_SYSTEM_INPUT_MODULE_SCROLL_DELTA;UNITY_INPUT_SYSTEM_SENDPOINTERHOVERTOPARENT;UNITY_INPUT_SYSTEM_INPUT_MODULE_NAVIGATION_DEVICE_TYPE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0169;CS0067;CS0108;CS0114;CS0162;CS0219;CS0672</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(InputSystemSource)/**/*.cs" Exclude="$(InputSystemSource)/Plugins/InputForUI/**" />
    <ProjectReference Include="../UGUI/UnityEngine.UI.csproj" />
  </ItemGroup>
</Project>
