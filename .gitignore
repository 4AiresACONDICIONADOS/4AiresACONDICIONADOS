*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# Offline compile-check output (Tools/CompileCheck)
/Tools/CompileCheck/bin/
/Tools/CompileCheck/obj/
/Tools/CompileCheck/**/bin/
/Tools/CompileCheck/**/obj/

# Python caches (Tools/)
__pycache__/
*.pyc
