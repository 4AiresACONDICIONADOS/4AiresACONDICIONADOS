<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-check of the game runtime as a PLAYER build (no UNITY_EDITOR). -->
  <PropertyGroup>
    <UnityProject>true</UnityProject>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>BreathOfEclipse.Runtime</AssemblyName>
    <DefineConstants>$(UnityDefines)</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_BreathOfEclipse/Scripts/Logic/**/*.cs" />
    <Compile Include="../../../Assets/_BreathOfEclipse/Scripts/Runtime/**/*.cs" />
    <Reference Include="$(CompileCheckOut)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(CompileCheckOut)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(CompileCheckOut)/Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
  </ItemGroup>
</Project>
